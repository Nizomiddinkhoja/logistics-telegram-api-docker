# Docker
TAG=latest

# Общий ключ с logistics-api (TELEGRAM_SERVICE_KEY там), заголовок X-Api-Key.
# Сгенерировать: openssl rand -hex 32
API_KEY=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=20000

# Telegram Gateway API (коды подтверждения)
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_URL=https://gatewayapi.telegram.org
TELEGRAM_GATEWAY_TIMEOUT_MS=10000
TELEGRAM_GATEWAY_CODE_TTL=300
TELEGRAM_CODE_CHANNEL_USERNAME=

# Чаты (prod)
TELEGRAM_CHANNEL_TJ_ID=-1002149734011
TELEGRAM_CHANNEL_UZ_ID=-1002901048715
TELEGRAM_MODERATOR_CHAT_ID=-1003716260421
TELEGRAM_MONITORING_CHAT_ID=-4152240223
TELEGRAM_BALANCE_GROUP_ID=-1004429805124
